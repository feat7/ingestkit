# IngestKit Server Configuration
# Generated by: ingestkit init --server

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_DB=ingestkit
POSTGRES_USER=ingestkit
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_PORT=5433

# =============================================================================
# Redpanda Configuration
# =============================================================================
REDPANDA_PORT=19092
REDPANDA_TOPIC=ingestkit.events

# =============================================================================
# API Server Configuration
# =============================================================================
API_PORT=8080
RATE_LIMIT_RPS=1000
LOG_LEVEL=info

# API Keys (format: key:tenant_id)
# Add your API keys here
API_KEY_1=dev_key_1234567890:default
# API_KEY_2=your_key:your_tenant

# =============================================================================
# Consumer Configuration
# =============================================================================
CONSUMER_WORKERS=4
CONSUMER_BATCH_SIZE=500
CONSUMER_GROUP_ID=ingestkit-consumer
METRICS_PORT=8081
