  "cards": [
    {
      "dot": "cyan",
      "title": "Broker acceptance",
      "items": [
        "202 follows all broker acknowledgements in the response.",
        "A timeout can be ambiguous; retry the same UUID and bytes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Storage effect",
      "items": [
        "One SQL statement commits a valid segment atomically.",
        "The unique (tenant_id,event_id) key keeps replay from creating another row."
      ]
    },
    {
      "dot": "amber",
      "title": "Crash boundary",
      "items": [
        "A crash after SQL commit and before offset commit causes replay.",
        "This is idempotent storage, not a transaction spanning Kafka and PostgreSQL."
      ]
