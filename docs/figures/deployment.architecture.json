  "cards": [
    {
      "dot": "cyan",
      "title": "Acceptance",
      "items": [
        "202 means the broker acknowledged the request. PostgreSQL storage is asynchronous.",
        "API keys stay in trusted application backends."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence",
      "items": [
        "PostgreSQL, Redpanda and Caddy use named volumes.",
        "SQL commits before source offsets; replay deduplicates by tenant and UUID.",
        "Malformed records require an acknowledged DLQ write on the same broker before offset progress."
      ]
    },
    {
      "dot": "amber",
      "title": "One host",
      "items": [
        "Only Caddy publishes ports 80/443. Dependencies and metrics stay private.",
        "One broker/replica and finite retention do not protect against host or disk loss."
      ]
    }
  ]
