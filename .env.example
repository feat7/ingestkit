# IngestKit Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# Note: Port 5433 is used by default to avoid conflicts with existing PostgreSQL
# installations that typically use 5432. Change if needed.
POSTGRES_DB=ingestkit
POSTGRES_USER=ingestkit
POSTGRES_PASSWORD=ingestkit_dev
POSTGRES_PORT=5433

# Database connection for API and Consumer
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ingestkit
DB_USER=ingestkit
DB_PASSWORD=ingestkit_dev
DATABASE_URL=postgres://ingestkit:ingestkit_dev@localhost:5433/ingestkit?sslmode=disable

# =============================================================================
# Redpanda Configuration
# =============================================================================
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644

# =============================================================================
# Redis Configuration (optional, used with --profile full)
# =============================================================================
REDIS_PORT=6379

# =============================================================================
# pgAdmin Configuration (optional, used with --profile full)
# =============================================================================
PGADMIN_EMAIL=admin@ingestkit.local
PGADMIN_PASSWORD=admin

# =============================================================================
# Application Configuration
# =============================================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=10s
REDPANDA_ADDR=localhost:19092
SCHEMA_PATH=schema/events.yaml

# Authentication
# Format: API_KEY_N=apikey:tenant_id
# Example: API_KEY_1=sk_prod_abc123:acme_corp
# If no tenant_id provided, defaults to "default"
API_KEY_1=dev_key_1234567890:default
API_KEY_2=sk_test_tenant_alpha:tenant_alpha
# API_KEY_3=your_key:your_tenant
# API_KEY_4=your_key:your_tenant
# Up to API_KEY_10 supported

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
# For production, specify allowed origins:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com

# Consumer Worker
CONSUMER_GROUP_ID=ingestkit-consumer
CONSUMER_WORKERS=4
CONSUMER_BATCH_SIZE=500          # Optimized for COPY protocol (500 events OR 20ms timeout)

# Redpanda Topic
REDPANDA_TOPIC=ingestkit.events

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Development Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=true
