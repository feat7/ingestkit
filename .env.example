# IngestKit Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_DB=ingestkit
POSTGRES_USER=ingestkit
POSTGRES_PASSWORD=ingestkit_dev
POSTGRES_PORT=5433

# =============================================================================
# Redpanda Configuration
# =============================================================================
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644

# =============================================================================
# Redis Configuration (optional, used with --profile full)
# =============================================================================
REDIS_PORT=6379

# =============================================================================
# pgAdmin Configuration (optional, used with --profile full)
# =============================================================================
PGADMIN_EMAIL=admin@ingestkit.local
PGADMIN_PASSWORD=admin

# =============================================================================
# Application Configuration
# =============================================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=10s

# Authentication
API_KEY_1=dev_key_1234567890_replace_in_production
API_KEY_2=dev_key_0987654321_replace_in_production

# Consumer Worker
CONSUMER_GROUP_ID=ingestkit-consumer
CONSUMER_WORKERS=4
CONSUMER_BATCH_SIZE=100

# Redpanda Topic
REDPANDA_TOPIC=ingestkit.events

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Development Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=true
