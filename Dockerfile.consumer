# Build stage
FROM golang:1.23-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

WORKDIR /build

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code (except generated/)
COPY . .

# Generate code from schema
RUN mkdir -p generated/models generated/storage generated/consumer generated/sql && \
    go build -o /tmp/ingestkit ./cmd/cli && \
    /tmp/ingestkit schema compile

# Build the consumer binary
RUN CGO_ENABLED=0 GOOS=linux go build -o consumer ./cmd/consumer

# Runtime stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata wget

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/consumer .

# Consumer metrics on port 8081
EXPOSE 8081

# Health check endpoint
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8081/health || exit 1

# Run as non-root user
RUN addgroup -g 1000 ingestkit && \
    adduser -D -u 1000 -G ingestkit ingestkit && \
    chown -R ingestkit:ingestkit /app

USER ingestkit

CMD ["./consumer"]
